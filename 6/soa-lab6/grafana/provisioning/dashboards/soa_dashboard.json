{
  "annotations": { "list": [] },
  "editable": true,
  "id": null,
  "title": "SOA Calendar — Observability (p50/p95/p99, Health, Shards)",
  "uid": "soa-calendar-obs",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Service Health (Consul + Prometheus up)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "up{job=\"soa-microservices\"}", "legendFormat": "{{service}} ({{instance_id}})" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Throughput (Requests / sec per service)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(http_requests_total[1m])) by (service)", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate (HTTP 5xx / sec)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m])) by (service)", "legendFormat": "{{service}} 5xx" }
      ]
    },
    {
      "id": 4,
      "title": "Latency Quantiles: p50, p95, p99 (seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, service))", "legendFormat": "p50 {{service}}" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, service))", "legendFormat": "p95 {{service}}" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, service))", "legendFormat": "p99 {{service}}" }
      ]
    },
    {
      "id": 5,
      "title": "Replica / Shard Request Distribution",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(http_requests_total) by (instance_id)", "legendFormat": "{{instance_id}}" }
      ]
    },
    {
      "id": 6,
      "title": "Business Metrics: Events Created & Notifications Processed",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "calendar_events_created_total", "legendFormat": "Events Created" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "notifications_processed_total", "legendFormat": "Notifications Processed" }
      ]
    },
    {
      "id": 7,
      "title": "Queue Processing Lag (seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "queue_lag_seconds", "legendFormat": "Queue Lag ({{service}})" }
      ]
    }
  ]
}
